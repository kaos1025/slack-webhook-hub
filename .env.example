SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=xoxb-your-token
# Optional: enables @bot mention commands such as "@slack-webhook-hub do this".
# Set this to the Bot User ID, not the App ID.
SLACK_BOT_USER_ID=

# Legacy single-project routing (kept for backward compatibility)
SLACK_EXECUTOR=noop
SLACK_ROUTINE_CHANNEL_ID=C0123456789
SLACK_ROUTINE_PROJECT=single-project-name
SLACK_ROUTINE_TRIGGER_ID=trig_your_routine_trigger_id
ROUTINE_TOKEN=your-routine-token

# Multi-project routing. When set, this replaces legacy single-project routing.
# Keep tokens in separate env vars and reference them with tokenEnv.
# SLACK_ROUTES_JSON='[{"channelId":"C_JULLYSSY","project":"jullyssy-mall","executor":"routine","triggerId":"trig_jullyssy","tokenEnv":"ROUTINE_TOKEN_JULLYSSY","allowedUserIds":["U_ALLOWED_USER"]},{"channelId":"C_HUB","project":"slack-webhook-hub","executor":"noop"},{"channelId":"C_WORKER","project":"worker-project","executor":"worker","workerQueue":"default","allowedUserIds":["U_ALLOWED_USER"]}]'
# ROUTINE_TOKEN_JULLYSSY=your-jullyssy-routine-token

# Worker executor persistence. Required only for routes with executor=worker.
COMMAND_JOBS_SUPABASE_URL=https://your-project.supabase.co
COMMAND_JOBS_SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
COMMAND_JOBS_TABLE=command_jobs
COMMAND_JOBS_FETCH_TIMEOUT_MS=2500
SLACK_WORKER_QUEUE=default

# Optional command-job dashboard API auth for GET /api/command-jobs.
# Required to enable the endpoint; clients must send Authorization: Bearer <token>.
DASHBOARD_AUTH_TOKEN=

# Worker skeleton runtime. Required only when running `npm run worker` or `npm run scheduler`.
WORKER_ID=worker-local-1
WORKER_BACKEND=placeholder
# For WORKER_BACKEND=local-command, configure a shell-free JSON argv template.
# Supported templates inside args: {{command}}, {{project}}, {{jobId}}, {{workspace}}
# Example: ["hermes","--prompt","{{command}}"] or ["opencode","run","{{command}}"]
AGENT_COMMAND_JSON=
AGENT_WORKSPACE_ROOT=/srv/agent-relay/workspaces
AGENT_WORKDIR=
AGENT_TIMEOUT_MS=300000
AGENT_OUTPUT_MAX_CHARS=12000
# Extra env names to pass into the agent process, comma-separated. Hub secrets are not passed by default.
AGENT_ENV_ALLOWLIST=GH_TOKEN,GITHUB_TOKEN,ANTHROPIC_API_KEY
WORKER_POLL_INTERVAL_MS=5000
WORKER_MAX_ITERATIONS=0
WORKER_FETCH_TIMEOUT_MS=10000
